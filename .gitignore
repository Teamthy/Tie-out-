# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# node
web/node_modules/
web/.next/
web/out/

# generated runs (the committed demo runs are the reproducible public
# samples: F1 at 0.2.0, F2 and the F1 stability pair at 0.3.0)
runs/*
!runs/demo/
!runs/demo-f2/
!runs/demo-stability/

# environment
.env

# runtime artifact of the verify endpoint (the report is the response;
# the file is a local convenience, and serverless hosts are read-only)
runs/**/verify_report.json
